def a_star(graph, start, goal, h):
    open_list = [start]
    g = {start: 0}
    parent = {start: None}

    while open_list:
        current = min(open_list, key=lambda x: g[x] + h[x])

        if current == goal:
            path = []
            while current:
                path.append(current)
                current = parent[current]
            return path[::-1]

        open_list.remove(current)

        for neighbour, cost in graph[current]:
            temp_g = g[current] + cost

            if neighbour not in g or temp_g < g[neighbor]:
                g[neighbour] = temp_g
                parent[neighbour] = current
                open_list.append(neighbour)

    return None

# -------- USER INPUT --------
graph = {}
n = int(input("Enter number of nodes: "))

for i in range(n):
    node = input("Enter node: ")
    neighbours = []
    m = int(input(f"Enter number of neighbours of {node}: "))
    
    for j in range(m):
        nbr = input("Enter neighbour: ")
        cost = int(input("Enter cost: "))
        neighbours.append((nbr, cost))
    
    graph[node] = neighbours

h = {}
for node in graph:
    h[node] = int(input(f"Enter heuristic value for {node}: "))

start = input("Enter start node: ")
goal = input("Enter goal node: ")

print("Path:", a_star(graph, start, goal, h))
